SHORTEN_ADDRESS=:8080
SHORTEN_DATABASE_PATH=.data/shorten.db
SHORTEN_PUBLIC_BASE_URL=http://localhost:8080
SHORTEN_ADMIN_API_KEY=change-me
SHORTEN_SESSION_SECRET=change-me-use-openssl-rand-hex-32
SHORTEN_INSECURE_COOKIES=true
SHORTEN_ALLOW_NULL_ORIGIN=false

# Optional tuning
SHORTEN_READ_CONNECTIONS=8
SHORTEN_CACHE_CAPACITY=10000
SHORTEN_CACHE_POSITIVE_TTL=5m
SHORTEN_CACHE_NEGATIVE_TTL=10s
SHORTEN_ANALYTICS_INTERVAL=250ms
SHORTEN_ANALYTICS_THRESHOLD=1000
SHORTEN_ANALYTICS_MAX_KEYS=50000
SHORTEN_SESSION_TTL=12h
SHORTEN_SHUTDOWN_TIMEOUT=15s
