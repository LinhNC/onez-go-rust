---
/**
 * Icon — inline stroke icons, 24x24 grid, currentColor, aria-hidden.
 * Identical path data to the Go templates so icon optics are unchanged.
 */
import { cn } from '../lib/cn';

type IconName =
  | 'brand'
  | 'plus'
  | 'search'
  | 'check'
  | 'back'
  | 'pencil'
  | 'dots'
  | 'link'
  | 'copy'
  | 'alert';

interface Props {
  name: IconName;
  class?: string;
  strokeWidth?: number;
}

const { name, class: className, strokeWidth = 2 } = Astro.props;

const glyphs: Record<IconName, { markup: string; filled?: boolean; width?: number }> = {
  brand: {
    markup:
      '<path d="M9.5 14.5 14.5 9"/><path d="M7.2 17.8H6a4 4 0 0 1 0-8h3M16.8 6.2H18a4 4 0 1 1 0 8h-3"/>',
    width: 2.1,
  },
  plus: { markup: '<path d="M12 5v14M5 12h14"/>' },
  search: { markup: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>' },
  check: { markup: '<path d="m5 12 4 4L19 6"/>' },
  back: { markup: '<path d="m15 18-6-6 6-6"/>' },
  pencil: {
    markup:
      '<path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4Z"/>',
    width: 1.9,
  },
  dots: {
    markup:
      '<circle cx="5" cy="12" r="1.6"/><circle cx="12" cy="12" r="1.6"/><circle cx="19" cy="12" r="1.6"/>',
    filled: true,
  },
  link: {
    markup:
      '<path d="M10.5 13.5 13.5 10.5"/><path d="M8 16H6a4 4 0 0 1 0-8h3M16 8h2a4 4 0 1 1 0 8h-3"/>',
    width: 1.8,
  },
  copy: {
    markup:
      '<rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h10a1 1 0 0 1 1 1v1"/>',
    width: 1.9,
  },
  alert: { markup: '<path d="M12 8v5"/><path d="M12 17h.01"/><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z"/>' },
};

const glyph = glyphs[name];
const stroke = strokeWidth ?? glyph.width ?? 2;
---

<svg
  viewBox="0 0 24 24"
  class={cn(className)}
  fill={glyph.filled ? 'currentColor' : 'none'}
  stroke={glyph.filled ? 'none' : 'currentColor'}
  stroke-width={glyph.width ?? stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={glyph.markup}
/>
