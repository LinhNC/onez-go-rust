---
/**
 * FormSection — a titled, divided block inside a form surface (never a card):
 * 17px title, one line of muted guidance, then the field grid.
 */
import { cn } from '../lib/cn';

interface Props {
  title: string;
  description?: string;
  class?: string;
}

const { title, description, class: className } = Astro.props;
---

<section class={cn('form-section', className)}>
  <h2>{title}</h2>
  {description && <p>{description}</p>}
  <slot />
</section>
