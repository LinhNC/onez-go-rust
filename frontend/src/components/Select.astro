---
/**
 * Select — native `<select class="control">` with the accepted 34px trailing
 * padding for the OS chevron. No custom arrow, no appearance reset: familiar
 * controls carry the experience (PRODUCT.md principle 4).
 */
import { cn } from '../lib/cn';

export interface SelectOption {
  value: string;
  label: string;
}

type Option = string | SelectOption;

interface Props {
  id?: string;
  name?: string;
  /** Selected value; compared against each option's value. */
  value?: string;
  options: Option[];
  disabled?: boolean;
  required?: boolean;
  invalid?: boolean;
  ariaLabel?: string;
  class?: string;
  form?: string;
  autofocus?: boolean;
}

const {
  options,
  value,
  disabled = false,
  required = false,
  invalid = false,
  ariaLabel,
  class: className,
  ...rest
} = Astro.props;

const normalized: SelectOption[] = options.map((option) =>
  typeof option === 'string' ? { value: option, label: option } : option,
);

/** Forward non-prop attributes (aria-label, hx-*, data-*) to the element. */
const forwarded: Record<string, string | number | boolean | undefined> = {};
for (const [key, raw] of Object.entries(rest)) {
  if (raw === undefined || raw === null) continue;
  forwarded[key] = raw as string | number | boolean;
}
---

<select
  class={cn('control', className)}
  required={required || undefined}
  disabled={disabled || undefined}
  aria-invalid={invalid ? 'true' : undefined}
  aria-label={ariaLabel}
  {... forwarded}
>
  {
    normalized.map((option) => (
      <option value={option.value} selected={value === option.value || undefined}>
        {option.label}
      </option>
    ))
  }
</select>
